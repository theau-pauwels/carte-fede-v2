---
import Layout from "../layouts/Layout.astro";
import VotePortal from "../components/VotePortal";
---

<Layout title="Vote">
  <main
    class="min-h-[calc(100vh-12rem)] bg-gradient-to-b from-slate-50 via-white to-blue-50/30 px-4 py-8 sm:px-6 lg:px-8"
  >
    <section class="mx-auto w-full max-w-6xl space-y-4">
      <h1 class="text-3xl font-semibold text-blue-900">Vote</h1>
      <p class="text-sm text-slate-600">
        Sélectionne un vote public ou rejoins une room avec son code.
      </p>
      <VotePortal client:load />
    </section>
  </main>
</Layout>
